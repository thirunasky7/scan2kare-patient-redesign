  void _toggleSearch() {
    setState(() {
      _isSearching = !_isSearching;
      if (!_isSearching) {
        _locationSearchController.clear();
        predictions = [];
        _searchFocusNode.unfocus();
      } else {
        _searchFocusNode.requestFocus();
      }
    });
  }

  // ================= PAGINATION METHODS =================

  void _resetPagination() {
    setState(() {
      currentPage = 1;
      hasMoreData = hospitals.isNotEmpty;
      displayedHospitals = [];
    });
    _loadMoreData();
  }

  void _loadMoreData() {
    if (!hasMoreData || isPaginationLoading) {
      return;
    }

    final startIndex = (currentPage - 1) * itemsPerPage;

    if (startIndex >= hospitals.length) {
      setState(() {
        hasMoreData = false;
      });
      return;
    }

    setState(() {
      isPaginationLoading = true;
    });

    // Small delay for smooth UX
    Future.delayed(const Duration(milliseconds: 300), () {
      if (mounted) {
        setState(() {
          final endIndex = (startIndex + itemsPerPage) < hospitals.length
              ? startIndex + itemsPerPage
              : hospitals.length;

          final newItems = hospitals.sublist(startIndex, endIndex);
          displayedHospitals.addAll(newItems);

          currentPage++;
          isPaginationLoading = false;

          if (displayedHospitals.length >= hospitals.length) {
            hasMoreData = false;
          }
        });
      }
    });
  }

  void _onScroll() {
    if (_scrollController.position.pixels >=
        _scrollController.position.maxScrollExtent - 200) {
      _loadMoreData();
    }
  }

  // ================= SEARCH METHODS =================

  void filterHospitalsBySearch(String query) {
    setState(() {
      searchQuery = query;
      _applySearch();
    });
  }

  void _applySearch() {
    if (searchQuery.isEmpty) {
      // Reset pagination with all hospitals
      _resetPagination();
      return;
    }

    final filtered = hospitals
        .where((hospital) =>
            hospital.name.toLowerCase().contains(searchQuery.toLowerCase()) ||
            hospital.address.toLowerCase().contains(searchQuery.toLowerCase()))
        .toList();

// ? ADD THIS LINE
    filtered.sort((a, b) => a.distance.compareTo(b.distance));

    // Update displayed hospitals with filtered results
    setState(() {
      displayedHospitals = filtered.take(itemsPerPage).toList();
      currentPage = 2; // Next page will load from index itemsPerPage
      hasMoreData = filtered.length > itemsPerPage;
    });
  }

  // ================= NAVIGATION =================

  void _openDoctors(HospitalItem hospital) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => DoctorListScreen(
          hospitalId: hospital.id,
          hospitalName: hospital.name,
          hospitalAddress: hospital.address,
        ),
      ),
    );
  }

  Future<void> _loadUserProfile() async {
    final prefs = await SharedPreferences.getInstance();
    setState(() {
      _userName = prefs.getString('user_name') ?? 'Stephen James';
      _address = prefs.getString('address') ?? 'Chitlapakkam, Chennai';
    });
  }

  // ================= BUILD =================

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      extendBodyBehindAppBar: true,
      appBar: _buildAppBar(),
      body: Stack(
        children: [
          Positioned.fill(
            child: Image.asset(
              'assets/gradient.png',
              fit: BoxFit.cover,
            ),
          ),
          SafeArea(
            child: _buildBody(),
          ),
          // Location Search Overlay
          if (_isSearching)
            Positioned.fill(
              child: SafeArea(
                child: Container(
                  color: Colors.white,
                  child: Column(
                    children: [
                      Container(
                        padding: const EdgeInsets.all(12),
                        color: Colors.white,
                        child: Row(
                          children: [
                            IconButton(
                              icon: const Icon(Icons.arrow_back),
                              onPressed: _toggleSearch,
                            ),
                            Expanded(
                              child: TextField(
                                controller: _locationSearchController,
                                focusNode: _searchFocusNode,
                                decoration: InputDecoration(
                                  hintText: "Search for your area, city...",
                                  border: OutlineInputBorder(
                                    borderRadius: BorderRadius.circular(8),
                                  ),
                                  suffixIcon: _locationSearchController
                                          .text.isNotEmpty
                                      ? IconButton(
                                          icon: const Icon(Icons.clear),
                                          onPressed: () {
                                            _locationSearchController.clear();
                                            setState(() => predictions = []);
                                          },
                                        )
                                      : null,
                                ),
                                onChanged: onSearchChanged,
                              ),
                            ),
                          ],
                        ),
                      ),

                      /// Current location
                      if (_locationSearchController.text.isEmpty)
                        ListTile(
                          leading: const Icon(Icons.my_location,
                              color: Color(0xFF243C90)),
                          title: const Text(
                            "Use My Current Location",
                            style: TextStyle(fontWeight: FontWeight.w500),
                          ),
                          onTap: useCurrentLocation,
                        ),

                      /// Predictions
                      Expanded(
                        child: ListView.builder(
                          itemCount: predictions.length,
                          itemBuilder: (context, index) {
                            final p = predictions[index];
                            return ListTile(
                              leading: const Icon(Icons.location_on),
                              title: Text(p.fullText ?? ""),
                              subtitle: Text(p.secondaryText),
                              onTap: () => selectPlace(p),
                            );
                          },
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ),
        ],
      ),
      bottomNavigationBar: _buildCustomBottomBar(),
    );
  }

  // ================= APP BAR =================

  AppBar _buildAppBar() {
    return AppBar(
      backgroundColor: Colors.transparent,
      surfaceTintColor: Colors.transparent,
      shadowColor: Colors.transparent,
      elevation: 0,
      scrolledUnderElevation: 0,
      centerTitle: true,
      title: GestureDetector(
        onTap: _toggleSearch,
        child: Column(
          children: [
            Text(
              _userName,
              style: const TextStyle(
                  color: Colors.black,
                  fontWeight: FontWeight.w600,
                  fontSize: 16),
            ),
            const SizedBox(height: 2),
            Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                const Icon(Icons.location_on, size: 14, color: Colors.grey),
                const SizedBox(width: 4),
                Flexible(
                  child: Text(
                    _address.isNotEmpty ? _address : "Tap to set location",
                    style: const TextStyle(fontSize: 12, color: Colors.grey),
                    overflow: TextOverflow.ellipsis,
                    maxLines: 1,
                  ),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  // ================= BODY =================

  Widget _buildBody() {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(12),
      controller: _scrollController,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // Screen Title based on type
          Padding(
            padding: const EdgeInsets.symmetric(vertical: 8),
            child: Text(
              widget.type != null
                  ? '${widget.type!.toUpperCase()} HOSPITALS'
                  : 'NEARBY HOSPITALS',
              style: const TextStyle(
                fontSize: 18,
                fontWeight: FontWeight.bold,
                color: Color(0xFF243C90),
              ),
            ),
          ),
          const SizedBox(height: 8),
          _buildSearchBar(), // Hospital search bar
          const SizedBox(height: 12),
          _buildBannerCard(),
          const SizedBox(height: 12),
          isLoading
              ? const Center(child: CircularProgressIndicator())
              : hospitals.isEmpty
                  ? const Center(
                      child: Padding(
                        padding: EdgeInsets.all(32),
                        child: Text("No hospitals found"),
                      ),
                    )
                  : Column(
                      children: [
                        ListView.builder(
                          shrinkWrap: true,
                          physics: const NeverScrollableScrollPhysics(),
                          itemCount: displayedHospitals.length,
                          itemBuilder: (context, index) {
                            final hospital = displayedHospitals[index];
                            return hospitalCard(
                              hospital,
                              onTap: () => _openDoctors(hospital),
                            );
                          },
                        ),
                        if (isPaginationLoading)
                          const Padding(
                            padding: EdgeInsets.all(16),
                            child: Center(
                              child: CircularProgressIndicator(),
                            ),
                          ),
                        if (!hasMoreData && displayedHospitals.isNotEmpty)
                          const Padding(
                            padding: EdgeInsets.all(16),
                            child: Text(
                              "No more hospitals",
                              style: TextStyle(color: Colors.grey),
                            ),
                          ),
                      ],
                    ),
        ],
      ),
    );
  }

  // ================= SEARCH BAR =================

  Widget _buildSearchBar() {
    return TextField(
      controller: _hospitalSearchController,
      onChanged: filterHospitalsBySearch,
      decoration: InputDecoration(
        hintText: "Search by Hospital/Clinic name",
        prefixIcon: const Icon(Icons.search, size: 20),
        suffixIcon: _hospitalSearchController.text.isNotEmpty
            ? IconButton(
                icon: const Icon(Icons.clear, size: 18),
                onPressed: () {
                  _hospitalSearchController.clear();
                  filterHospitalsBySearch('');
                },
              )
            : null,
        filled: true,
        fillColor: Colors.grey.shade100,
        border: OutlineInputBorder(
          borderRadius: BorderRadius.circular(12),
          borderSide: BorderSide.none,
        ),
        contentPadding: const EdgeInsets.symmetric(vertical: 12),
      ),
    );
  }

  // ================= BANNER =================

  Widget _buildBannerCard() {
    return Container(
      height: 120,
      decoration: BoxDecoration(
        borderRadius: BorderRadius.circular(16),
        color: Colors.blue.shade50,
      ),
      child: Row(
        children: [
          Expanded(
            child: Padding(
              padding: const EdgeInsets.all(12),
              child: Text(
                widget.type != null
                    ? "Explore ${widget.type} hospitals near you"
                    : "Connect with the hospitals nearby you",
                style:
                    const TextStyle(fontSize: 16, fontWeight: FontWeight.w600),
              ),
            ),
          ),
          ClipRRect(
            borderRadius: BorderRadius.circular(16),
            child: Image.network(
              "https://images.unsplash.com/photo-1586773860418-d37222d8fce3",
              width: 140,
              height: 120,
              fit: BoxFit.cover,
              errorBuilder: (context, error, stackTrace) {
                return Container(
                  width: 140,
                  height: 120,
                  color: Colors.grey.shade300,
                  child: const Icon(Icons.image_not_supported),
                );
              },
            ),
          )
