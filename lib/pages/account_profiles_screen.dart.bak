import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;
import 'dart:convert';
import 'package:shared_preferences/shared_preferences.dart';

class PatientProfileScreen extends StatefulWidget {
  const PatientProfileScreen({super.key});

  @override
  State<PatientProfileScreen> createState() => _PatientProfileScreenState();
}

class _PatientProfileScreenState extends State<PatientProfileScreen> {
  final TextEditingController nameController = TextEditingController();
  final TextEditingController ageController = TextEditingController();
  final TextEditingController phoneController = TextEditingController();

  String? selectedGender;
  String? selectedRelation;

  List<Map<String, dynamic>> patients = [];
  bool isLoading = false;

  int? editingFamilyId;
  bool isEditMode = false;

  final List<String> genders = ["male", "female", "other"];
  final List<String> relations = [
    "Self",
    "Father",
    "Mother",
    "Spouse",
    "Child"
  ];

  void deletePatient(int index) {
    setState(() {
      patients.removeAt(index);
    });
  }

  void editPatient(int index) {
    final p = patients[index];

    nameController.text = p["name"] ?? "";
    ageController.text = p["age"] ?? "";
    phoneController.text = p["phone"] ?? "";

    // gender
    String gender = (p["gender"] ?? "").toString().toLowerCase().trim();
    selectedGender = genders.contains(gender) ? gender : null;

    // relationship
    String relation = (p["relationship"] ?? "").toString().trim().toLowerCase();

    final matchedRelation = relations.firstWhere(
      (e) => e.toLowerCase() == relation,
      orElse: () => "",
    );

    selectedRelation = matchedRelation.isEmpty ? null : matchedRelation;

    // ✅ store edit id
    editingFamilyId = p["id"];
    isEditMode = true;

    setState(() {});
  }

  // ================= FETCH API =================
  Future<void> fetchPatients() async {
    setState(() => isLoading = true);

    try {
      final prefs = await SharedPreferences.getInstance();
      final token = prefs.getString('token');

      final response = await http.get(
        Uri.parse('https://scan2kare.com/api/patient/family-profiles'),
        headers: {
          "Accept": "application/json",
          if (token != null) "Authorization": "Bearer $token",
        },
      );

      final data = jsonDecode(response.body);

      if (response.statusCode == 200 && data['data'] != null) {
        final List list = data['data'];

        setState(() {
          patients = list.map<Map<String, dynamic>>((e) {
            return {
              "id": e["id"],
              "name": e["name"] ?? "-",
              "relationship": e["relationship"] ?? "-",
              "gender": e["gender"] ?? "-",
              "age": e["age"]?.toString() ?? "-",
              "phone": e["phone"] ?? "-",
            };
          }).toList();
        });
      } else {
        setState(() => patients = []);
      }
    } catch (e) {
      debugPrint("API Error: $e");
      setState(() => patients = []);
    }

    setState(() => isLoading = false);
  }

  Future<void> updateFamilyMember() async {
    if (editingFamilyId == null) return;

    try {
      final prefs = await SharedPreferences.getInstance();
      final token = prefs.getString('token');

      final response = await http.put(
        Uri.parse(
            'https://scan2kare.com/api/patient/family-profiles/$editingFamilyId'),
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json",
          if (token != null) "Authorization": "Bearer $token",
        },
        body: jsonEncode({
          "name": nameController.text,
          "age": int.tryParse(ageController.text) ?? 0,
          "gender": selectedGender ?? "",
          "relationship": selectedRelation?.toLowerCase() ?? "",
          "phone": phoneController.text,
        }),
      );

      final data = jsonDecode(response.body);

      if (response.statusCode == 200) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text("Family member updated successfully")),
        );

        // clear form
        nameController.clear();
        ageController.clear();
        phoneController.clear();

        selectedGender = null;
        selectedRelation = null;

        editingFamilyId = null;
        isEditMode = false;

        fetchPatients();
      } else {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text(data['message'] ?? "Update failed")),
        );
      }
    } catch (e) {
      debugPrint("Update Error: $e");

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text("Something went wrong")),
      );
    }
  }

  @override
  void initState() {
    super.initState();
    fetchPatients();
  }

  // ✅ FIX: refresh when coming back to screen
  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    fetchPatients();
  }

  @override
  void dispose() {
    nameController.dispose();
    ageController.dispose();
    phoneController.dispose();
    super.dispose();
  }

  // ================= ADD LOCAL PATIENT =================
  void addPatient() {
    if (nameController.text.isEmpty || selectedRelation == null) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text("Name and Relationship required")),
      );
      return;
    }

    setState(() {
      patients.add({
        "name": nameController.text,
        "relationship": selectedRelation ?? "-",
        "gender": selectedGender ?? "-",
        "age": ageController.text.isEmpty ? "-" : ageController.text,
        "phone": phoneController.text,
      });

      nameController.clear();
      ageController.clear();
      phoneController.clear();
      selectedGender = null;
      selectedRelation = null;
    });
  }

  // ================= UI COMPONENTS =================
  Widget buildInputField(String label, TextEditingController controller) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(label, style: const TextStyle(fontWeight: FontWeight.w500)),
        const SizedBox(height: 6),
        TextField(
          controller: controller,
          decoration: InputDecoration(
            border: OutlineInputBorder(
              borderRadius: BorderRadius.circular(8),
            ),
          ),
        ),
      ],
    );
  }

  Widget buildDropdown(String label, String? value, List<String> items,
      Function(String?) onChanged) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(label, style: const TextStyle(fontWeight: FontWeight.w500)),
        const SizedBox(height: 6),
        DropdownButtonFormField<String>(
          value: value,
          hint: const Text("Select"),
          items: items
              .map((e) => DropdownMenuItem(value: e, child: Text(e)))
              .toList(),
          onChanged: onChanged,
          decoration: InputDecoration(
            border: OutlineInputBorder(
              borderRadius: BorderRadius.circular(8),
            ),
          ),
        ),
      ],
    );
  }

  Widget buildTableHeader() {
    return const Row(
      children: [
        Expanded(
            child: Text("Name", style: TextStyle(fontWeight: FontWeight.bold))),
        Expanded(
            child: Text("Relation",
                style: TextStyle(fontWeight: FontWeight.bold))),
        Expanded(
            child:
                Text("Gender", style: TextStyle(fontWeight: FontWeight.bold))),
        Expanded(
            child: Text("Age", style: TextStyle(fontWeight: FontWeight.bold))),
        Expanded(
            child:
                Text("Phone", style: TextStyle(fontWeight: FontWeight.bold))),
        SizedBox(
            width: 80,
            child:
                Text("Actions", style: TextStyle(fontWeight: FontWeight.bold))),
      ],
    );
  }

  Widget buildTableRow(Map<String, dynamic> p, int index) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 8),
      child: Row(
        children: [
          Expanded(child: Text(p["name"] ?? "-")),
          Expanded(child: Text(p["relationship"] ?? "-")),
          Expanded(child: Text(p["gender"] ?? "-")),
          Expanded(child: Text(p["age"] ?? "-")),
          Expanded(child: Text(p["phone"] ?? "-")),
          SizedBox(
            width: 80,
            child: Row(
              children: [
                GestureDetector(
                  onTap: () => editPatient(index),
                  child: const Icon(Icons.edit, color: Colors.blue, size: 20),
                ),
                const SizedBox(width: 10),
                GestureDetector(
                  onTap: () => deletePatient(index),
                  child: const Icon(Icons.delete, color: Colors.red, size: 20),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  // ================= MAIN UI =================
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      extendBodyBehindAppBar: true,
      appBar: AppBar(
        backgroundColor: Colors.transparent,
        elevation: 0,
        title: const Text("Patient Profiles"),
      ),
      body: Stack(
        children: [
          Positioned.fill(
            child: Image.asset(
              'assets/gradient.png',
              fit: BoxFit.cover,
            ),
          ),
          SafeArea(
            child: isLoading
                ? const Center(child: CircularProgressIndicator())
                : ListView(
                    padding: const EdgeInsets.all(16),
                    children: [
                      const Text(
                        "Patient profiles under this account",
                        style: TextStyle(
                            fontSize: 18, fontWeight: FontWeight.bold),
                      ),
                      const SizedBox(height: 5),
                      const Text(
                        "Add family members and book appointments from same account.",
                        style: TextStyle(color: Colors.grey),
                      ),
                      const SizedBox(height: 20),
                      buildInputField("Name *", nameController),
                      const SizedBox(height: 15),
                      buildInputField("Age", ageController),
                      const SizedBox(height: 15),
                      buildDropdown("Gender", selectedGender, genders,
                          (val) => setState(() => selectedGender = val)),
                      const SizedBox(height: 15),
                      buildDropdown(
                          "Relationship *",
                          selectedRelation,
                          relations,
                          (val) => setState(() => selectedRelation = val)),
                      const SizedBox(height: 15),
                      buildInputField("Phone", phoneController),
                      const SizedBox(height: 25),
                      Center(
                        child: SizedBox(
                          width: 220,
                          child: ElevatedButton(
                            onPressed: () {
                              if (isEditMode) {
                                updateFamilyMember();
                              } else {
                                addPatient();
                              }
                            },
                            style: ElevatedButton.styleFrom(
                              backgroundColor: const Color(0xFF2B6F71),
                              padding: const EdgeInsets.symmetric(vertical: 14),
                            ),
                            child: Text(
                              isEditMode
                                  ? "Update patient profile"
                                  : "Add patient profile",
                              style: TextStyle(color: Colors.white),
                            ),
                          ),
                        ),
                      ),
                      const SizedBox(height: 25),
                      buildTableHeader(),
                      const Divider(),
                      ...patients.asMap().entries.map((entry) {
                        return buildTableRow(entry.value, entry.key);
                      }).toList(),
                    ],
                  ),
          ),
        ],
      ),
    );
  }
}
